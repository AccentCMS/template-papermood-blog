{%- extends "base.html.jinja" -%}
{%- from "_macros/i18n.jinja" import t -%}
{%- set lang = site.current_language -%}

{% block title %}{{ error.status | default(404) }} | {{ site.name }}{% endblock %}

{% block content %}
<div class="not-found">
    <div>{{ error.status | default(404) }}</div>
    <p class="not-found-hint">
        {{ t(lang, 'not_found') }}
        <a href="{{ url('/') }}">{{ t(lang, 'back_home') }}</a>
    </p>
</div>
{% endblock %}

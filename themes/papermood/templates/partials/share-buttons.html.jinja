{#- Share links for the current page, PaperMod style. The list is fixed and
    small; a site trims it with `site.extra.papermood.share_networks`
    (a list of names from: x, linkedin, reddit, facebook, whatsapp,
    telegram). -#}
{%- set pm = site.extra.papermood | default({}) -%}
{%- set networks = pm.share_networks | default(['x', 'linkedin', 'reddit', 'facebook', 'whatsapp', 'telegram', 'ycombinator']) -%}
{#- No urlencode filter is available, so the handful of characters that
    break a query string are percent-encoded by hand. -#}
{%- set share_url = absolute_url(page.canonical_url) | replace('&', '%26') | replace('#', '%23') | replace(' ', '%20') -%}
{%- set share_title = page.title | replace('%', '%25') | replace('&', '%26') | replace('+', '%2B') | replace('#', '%23') | replace('?', '%3F') | replace(' ', '%20') -%}
<ul class="share-buttons">
    {% if 'x' in networks %}
    <li>
        <a target="_blank" rel="noopener noreferrer" aria-label="share {{ page.title }} on x" href="https://x.com/intent/tweet/?text={{ share_title }}&amp;url={{ share_url }}">
            <svg version="1.1" viewBox="0 0 512 512" height="30" width="30" fill="currentColor" aria-hidden="true">
                <path d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48ZM364.4 421.8h39.1L151.1 88h-42L364.4 421.8Z" />
            </svg>
        </a>
    </li>
    {% endif %}
    {% if 'linkedin' in networks %}
    <li>
        <a target="_blank" rel="noopener noreferrer" aria-label="share {{ page.title }} on linkedin" href="https://www.linkedin.com/shareArticle?mini=true&amp;url={{ share_url }}&amp;title={{ share_title }}">
            <svg version="1.1" viewBox="0 0 512 512" height="30" width="30" fill="currentColor" aria-hidden="true">
                <path d="M136.5 87.5c0 27-21.9 48.9-48.9 48.9S38.7 114.5 38.7 87.5 60.6 38.6 87.6 38.6s48.9 21.9 48.9 48.9zM45.4 170.1h84.3v271.3H45.4V170.1zm135.5 0h80.8v37.1h1.2c11.2-21.3 38.7-43.8 79.7-43.8 85.3 0 101 56.1 101 129.1v148.9h-84.2V309.4c0-31.5-.6-72-43.9-72-43.9 0-50.6 34.3-50.6 69.7v134.3h-84V170.1z" />
            </svg>
        </a>
    </li>
    {% endif %}
    {% if 'reddit' in networks %}
    <li>
        <a target="_blank" rel="noopener noreferrer" aria-label="share {{ page.title }} on reddit" href="https://reddit.com/submit?url={{ share_url }}&amp;title={{ share_title }}">
            <svg version="1.1" viewBox="0 0 512 512" height="30" width="30" fill="currentColor" aria-hidden="true">
                <path d="M448 256c0-106-86-192-192-192S64 150 64 256s86 192 192 192 192-86 192-192zm-245.6 68.4c13.5 0 24.4 10.9 24.4 24.4s-10.9 24.4-24.4 24.4-24.4-10.9-24.4-24.4 10.9-24.4 24.4-24.4zm131.2 0c13.5 0 24.4 10.9 24.4 24.4s-10.9 24.4-24.4 24.4-24.4-10.9-24.4-24.4 10.9-24.4 24.4-24.4zm-65.6 104c-31.2 0-59.5-10.2-79.8-26.7-3.4-2.8-3.9-7.8-1.1-11.2 2.8-3.4 7.8-3.9 11.2-1.1 17.4 14.2 42.1 22.9 69.7 22.9s52.3-8.7 69.7-22.9c3.4-2.8 8.4-2.3 11.2 1.1 2.8 3.4 2.3 8.4-1.1 11.2-20.3 16.5-48.6 26.7-79.8 26.7zm160-156.4c0 14.3-8.3 26.6-20.3 32.5.6 3.8.9 7.7.9 11.6 0 59.8-62.7 108.3-140 108.3s-140-48.5-140-108.3c0-3.9.3-7.7.9-11.5-12.2-5.9-20.6-18.3-20.6-32.7 0-20 16.2-36.3 36.3-36.3 9.5 0 18.1 3.6 24.6 9.6 24.1-16.1 56.2-26.4 91.6-27.6l19.1-61.4c.9-2.9 3.9-4.7 6.9-4l49.4 11.6c4.4-9.9 14.3-16.8 25.8-16.8 15.6 0 28.3 12.7 28.3 28.3s-12.7 28.3-28.3 28.3-28.1-12.5-28.3-28l-43.5-10.2-15.9 51.1c33.5 2 63.7 12.1 86.7 27.5 6.5-5.8 15-9.3 24.3-9.3 20 0 36.1 16.2 36.1 36.3z" />
            </svg>
        </a>
    </li>
    {% endif %}
    {% if 'facebook' in networks %}
    <li>
        <a target="_blank" rel="noopener noreferrer" aria-label="share {{ page.title }} on facebook" href="https://facebook.com/sharer/sharer.php?u={{ share_url }}">
            <svg version="1.1" viewBox="0 0 512 512" height="30" width="30" fill="currentColor" aria-hidden="true">
                <path d="M449.4 0H62.6C28.1 0 0 28.1 0 62.6v386.8C0 483.9 28.1 512 62.6 512h193.1V315.1h-66.2v-76.7h66.2v-56.5c0-65.6 40-101.3 98.5-101.3 28 0 52.1 2.1 59.1 3v68.6h-40.6c-31.8 0-38 15.1-38 37.3v48.9h75.9l-9.9 76.7h-66V512h129.4c34.5 0 62.6-28.1 62.6-62.6V62.6C512 28.1 483.9 0 449.4 0z" />
            </svg>
        </a>
    </li>
    {% endif %}
    {% if 'whatsapp' in networks %}
    <li>
        <a target="_blank" rel="noopener noreferrer" aria-label="share {{ page.title }} on whatsapp" href="https://api.whatsapp.com/send?text={{ share_title }}%20-%20{{ share_url }}">
            <svg version="1.1" viewBox="0 0 512 512" height="30" width="30" fill="currentColor" aria-hidden="true">
                <path d="M449.5 123.9C397.8 51.2 321.9 8 240.4 8 107.9 8 .3 115.6.3 248.1c0 44.4 12.1 87.7 35.1 125.6L0 504l133.4-34.9c36.5 20 77.7 30.5 119.6 30.5h.1c132.4 0 243.2-107.6 243.2-240.1 0-49.5-17.6-98-46.8-135.6zm-209 339.6h-.1c-37.4 0-74-10-106-29l-7.6-4.5-79.1 20.7 21.1-77.1-5-7.9c-20.9-33.2-32-71.6-32-110.9C31.8 138.2 125.4 44.6 240.5 44.6c55.7 0 108.1 21.7 147.5 61.2 39.4 39.4 63.9 91.9 63.8 147.6 0 115.3-96.1 210.1-211.3 210.1zm115.9-157.5c-6.3-3.2-37.4-18.5-43.2-20.6-5.8-2.1-10-3.2-14.2 3.2-4.2 6.3-16.3 20.6-20 24.8-3.7 4.2-7.4 4.7-13.7 1.6-6.3-3.2-26.7-9.8-50.8-31.3-18.8-16.8-31.5-37.5-35.2-43.8-3.7-6.3-.4-9.7 2.8-12.9 2.8-2.8 6.3-7.4 9.5-11.1 3.2-3.7 4.2-6.3 6.3-10.5 2.1-4.2 1.1-7.9-.5-11.1-1.6-3.2-14.2-34.3-19.5-46.9-5.1-12.3-10.4-10.6-14.2-10.8-3.7-.2-7.9-.2-12.1-.2s-11.1 1.6-16.9 7.9c-5.8 6.3-22.1 21.6-22.1 52.7s22.7 61.1 25.8 65.3c3.2 4.2 44.6 68.1 108.1 95.5 15.1 6.5 26.9 10.4 36.1 13.3 15.2 4.8 29 4.1 39.9 2.5 12.2-1.8 37.4-15.3 42.7-30.1 5.3-14.8 5.3-27.4 3.7-30.1-1.6-2.6-5.8-4.2-12.1-7.4z" />
            </svg>
        </a>
    </li>
    {% endif %}
    {% if 'ycombinator' in networks %}
    <li>
        <a target="_blank" rel="noopener noreferrer" aria-label="share {{ page.title }} on ycombinator" href="https://news.ycombinator.com/submitlink?t={{ share_title }}&amp;u={{ share_url }}">
            <svg version="1.1" viewBox="0 0 512 512" height="30" width="30" fill="currentColor" aria-hidden="true">
                <path d="M449.446 0C483.971 0 512 28.03 512 62.554v386.892C512 483.97 483.97 512 449.446 512H62.554C28.03 512 0 483.97 0 449.446V62.554C0 28.03 28.029 0 62.554 0h386.892zM183.8 102.7h-62.27L240.8 320.37V409.3h30.4v-88.93l119.27-217.67h-62.27L256 219.24 183.8 102.7z" />
            </svg>
        </a>
    </li>
    {% endif %}
    {% if 'telegram' in networks %}
    <li>
        <a target="_blank" rel="noopener noreferrer" aria-label="share {{ page.title }} on telegram" href="https://telegram.me/share/url?text={{ share_title }}&amp;url={{ share_url }}">
            <svg version="1.1" viewBox="2 2 28 28" height="30" width="30" fill="currentColor" aria-hidden="true">
                <path d="M26.49 29.86H5.5a3.37 3.37 0 01-2.47-1 3.35 3.35 0 01-1-2.47V5.48A3.36 3.36 0 013 3a3.37 3.37 0 012.47-1h21a3.38 3.38 0 012.47 1 3.36 3.36 0 011 2.46v20.91a3.35 3.35 0 01-1 2.47 3.38 3.38 0 01-2.46 1.02zm-5.38-6.71a.79.79 0 00.85-.66L24.73 9.24a.55.55 0 00-.18-.46.62.62 0 00-.41-.17q-.08 0-16.53 6.11a.59.59 0 00-.41.59.57.57 0 00.43.52l4 1.24 1.61 4.83a.62.62 0 00.63.43.56.56 0 00.4-.17L16.54 20l4.09 3a.9.9 0 00.48.15z" />
            </svg>
        </a>
    </li>
    {% endif %}
</ul>
